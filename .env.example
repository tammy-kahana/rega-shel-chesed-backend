# העתיקי את הקובץ הזה לקובץ חדש בשם .env ומלאי את הערכים.
# את קובץ .env לא מעלים ל-GitHub (הוא כבר מופיע ב-.gitignore).

# סביבה: development (פיתוח) / production (ענן)
NODE_ENV=development

# הפורט שהשרת מאזין לו. בענן Render קובע אותו אוטומטית
PORT=3000

# כתובת החיבור למסד הנתונים PostgreSQL
# מקומית למשל: postgresql://postgres:הסיסמה_שלך@localhost:5432/volunteers
# ב-Neon: מעתיקים את ה-Connection string מהאתר (מסתיים ב-?sslmode=require)
DATABASE_URL=postgresql://postgres:password@localhost:5432/volunteers

# מפתח סודי לחתימת ה-Token. לפחות 32 תווים אקראיים. לא לשתף!
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars

# תוקף ה-Token (למשל 8h = שמונה שעות, 1d = יום)
JWT_EXPIRES_IN=8h

# מאילו אתרים מותר לפנות לשרת. * = מכולם.
# אחרי העלאת ה-React לענן אפשר לכתוב את כתובתו, למשל: https://my-app.onrender.com
# כמה כתובות - מפרידים בפסיק: http://localhost:5173,https://my-app.onrender.com
CORS_ORIGIN=*

# הסיסמה של כל משתמשי ההדגמה שה-Seed יוצר
SEED_DEMO_PASSWORD=Hesed2026

# רק להרצת הבדיקות האוטומטיות (npm test): מסד נתונים נפרד, שנמחק בכל הרצה!
# לעולם לא להכניס כאן את מסד הנתונים האמיתי
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/volunteers_test
